# Public site configuration
NEXT_PUBLIC_SITE_URL=https://flowsites.ca
NEXT_PUBLIC_CONTACT_EMAIL=hello@flowsites.ca
NEXT_PUBLIC_CONTACT_PHONE=

# Lead form delivery (Resend: https://resend.com)
RESEND_API_KEY=
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL="Flowsites <website@flowsites.ca>"

# Optional Cloudflare Turnstile spam protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Google Analytics 4 measurement ID (events also go to window.dataLayer without it)
NEXT_PUBLIC_GA_ID=
